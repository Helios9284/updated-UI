# MEV counter-strategy bot (new_bot.py)
# Copy into ultra-mempool/.env or merge with existing keys.

STAKE_API_TOKEN=1233
STAKE_SIGNER_WALLET_NAME=
STAKE_SIGNER_WALLET_PASSWORD=
STAKE_DEFAULT_USE_PROXY=false
STAKE_CHAIN_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
PROXY_DELEGATE_WALLET_NAME=proxy_delegate
PROXY_DELEGATE_WALLET_PASSWORD=
NETWORK=finney
RPC_URL=wss://entrypoint-finney.opentensor.ai:443
PROXY_VERIFY=1
STAKE_READ_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
# RPC_URL=ws://127.0.0.1:9944



# Funding wallet (your main coldkey, e.g. moon)
FUNDING_WALLET_NAME=
FUNDING_WALLET_PASSWORD=
# Falls back: STAKE_SIGNER_WALLET_NAME / STAKE_SIGNER_WALLET_PASSWORD / WALLET_NAME

BT_WALLETS_DIR=/root/.bittensor/wallets

# Validator hotkey (ss58) or resolve from wallet hotkey name
HOTKEY_SS58=
STAKE_HOTKEY_NAME=

NETUID=0
MAIN_AMOUNT=0.1
BAIT_AMOUNT=0.1

# Main MEV add_stake_limit slippage (%)
SLIPPAGE_PCT=1
# Bait public add_stake_limit slippage (%); empty = use SLIPPAGE_PCT
BAIT_SLIPPAGE_PCT=0.5
BAIT_ALLOW_PARTIAL=true
MAIN_ALLOW_PARTIAL=true

MAIN_FEE_BUFFER_TAO=0.1
# Free TAO on bait before stake (add_stake_limit tx fee)
BAIT_FEE_BUFFER_TAO=0.05
# Funding → bait after stake (remove_stake + transfer_all fees)
BAIT_REFUND_BUFFER_TAO=0.02
WALLET_REFUND_MIN_BALANCE_TAO=0.01
PROXY_FUND_TAO=0.1
BAIT_BLOCK_AGE_SEC=2
ROUND_WAIT_SEC=12
AUTO_UNSTAKE_ENABLED=1
MEMPOOL_TARGETS=
BLOCK_TARGETS=
FOLLOW_STAKE_BOT_ENABLED=0
FOLLOW_STAKE_BOT_TARGETS=[]
AUTO_UNSTAKE_DEFAULT_REMOVE_SLIPPAGE_PCT=100.0

TRACK_FIRE_SIGNER=
TRACK_TRANSFER_LEG2_MARGIN_PCT=2.0
TRACK_STAKE_HOTKEY=
TRACK_STAKE_AMOUNT_TAO=10
STARTCALLSUBMITWALLET=
TRACK_POLL_PROCESS_COUNT=1
TRACK_LEG1_CONFIRM_POLL_MS=100
TRACK_STAKE_TIP_TAO=0.001
TRACK_POLL_INTERVAL_SEC=0
